<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- REST API, WebSocket va media yuklash uchun. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        .App — Hilt ildizi (@HiltAndroidApp). localeConfig — Android 13+ da ilova tilini tizim sozlamalaridan
        tanlash imkoni. Starting tema — tizim splash screen'i (core-splashscreen), keyin Theme.SwiftChat.
    -->
    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SwiftChat.Starting">
        <!--
            Yagona Activity (single-activity + Compose). adjustResize — klaviatura ochilganda kontent
            siqiladi, xabar yozish maydoni klaviatura ostida qolmaydi.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SwiftChat.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            WorkManager'ning avtomatik initializer'i o'chiriladi: uni App o'zi HiltWorkerFactory bilan
            sozlaydi (Configuration.Provider), shunda OutboxWorker'ga bog'liqliklar inject qilinadi.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>